# ThreatIntel Analyzer 2.0 — Git Ignore
# Do NOT commit secrets or local data to GitHub

# ── Secrets & Environment ─────────────────────────────────
.env
*.env
.env.*

# ── Database (local SQLite only — use PostgreSQL on Render) ──
threat_cache.db
threat_cache.db-shm
threat_cache.db-wal
*.db

# ── Generated Reports & Logs ──────────────────────────────
reports/
logs/
*.log

# ── Python Cache ─────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.py[cod]

# ── Virtual Environment ──────────────────────────────────
venv/
env/
.venv/
.env/
ENV/

# ── IDE & System ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Build artifacts ──────────────────────────────────────
dist/
build/
*.egg-info/
